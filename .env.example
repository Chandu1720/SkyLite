# SkyLite Private Theatre — Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="24h"

# Server
PORT=3000
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"
NODE_ENV="development"

# UPI Payment
UPI_ID="skylite@upi"
UPI_PAYEE_NAME="SkyLite Private Theatre"
UPI_CURRENCY="INR"

# WhatsApp
WHATSAPP_NUMBER="919876543210"

# Business Defaults
DEFAULT_TAX_PERCENT="18"
DEFAULT_HOLD_DURATION_MINUTES="10"
DEFAULT_VERIFICATION_TIMEOUT_MINUTES="120"

# File Uploads
MAX_FILE_SIZE_MB="5"
UPLOAD_DIR="./uploads"
